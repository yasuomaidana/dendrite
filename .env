# ------------------------------------------------------------------------------
# 1. Core Platform & Environment Settings
# ------------------------------------------------------------------------------
DENDRITE_ENV=development
DENDRITE_VERSION=0.1.0
DENDRITE_DATA_DIR=./data
DENDRITE_WORKSPACE_DIR=.

# ------------------------------------------------------------------------------
# 2. Control Plane Database (PostgreSQL 16) & Redis Cache
# ------------------------------------------------------------------------------
POSTGRES_DB=dendrite
POSTGRES_USER=dendrite
POSTGRES_PASSWORD=dendrite_password
POSTGRES_PORT=5432
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. LiteLLM Proxy Gateway & Token Governance
# ------------------------------------------------------------------------------
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-dendrite-master-key
LITELLM_BUDGET_CEILING_USD=50.00
STORE_MODEL_IN_DB=True

# ------------------------------------------------------------------------------
# 4. Issue Tracking: Self-Hosted Plane v2 Stack
# ------------------------------------------------------------------------------
PLANE_DB_NAME=plane_dev
PLANE_DB_USER=plane_user
PLANE_DB_PASSWORD=plane_password
PLANE_DB_PORT=5434
PLANE_REDIS_PORT=6380
PLANE_API_PORT=8090
PLANE_UI_PORT=8091
PLANE_SECRET_KEY=dendrite_plane_secret_key_mock_local
PLANE_ADMIN_EMAIL=dev@dendrite.ai
PLANE_ADMIN_PASSWORD=dendrite123
PLANE_API_KEY=plane_sec_dendrite_token_12345

# ------------------------------------------------------------------------------
# 5. Issue Tracking: Local Linear Mock Stack
# ------------------------------------------------------------------------------
LINEAR_PORT=8085
LINEAR_DB_PORT=5433
LINEAR_DB_NAME=linear_dev
LINEAR_DB_USER=linear_user
LINEAR_DB_PASSWORD=linear_password
LINEAR_API_KEY=lin_local_mock_key_dendrite
LINEAR_EMULATOR_MODE=true

# ------------------------------------------------------------------------------
# 6. UI & Design: Penpot Open-Source Platform
# ------------------------------------------------------------------------------
PENPOT_FRONTEND_PORT=9000
PENPOT_BACKEND_PORT=9001
PENPOT_DB_PORT=5435
PENPOT_DB_NAME=penpot_dev
PENPOT_DB_USER=penpot_user
PENPOT_DB_PASSWORD=penpot_password
PENPOT_REDIS_PORT=6381
PENPOT_SECRET_KEY=dendrite_penpot_secret_key_mock_local
PENPOT_PUBLIC_URI=http://localhost:9000
PENPOT_USER_EMAIL=dev@dendrite.ai
PENPOT_USER_PASSWORD=dendrite123

# ------------------------------------------------------------------------------
# 7. Telemetry & Observability: Prometheus & Grafana
# ------------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# ------------------------------------------------------------------------------
# 8. Pluggable Multi-Provider Inference Engines
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OXILLAMA_BASE_URL=http://localhost:8080
LLAMACPP_ENDPOINT=http://localhost:8081
HF_TGI_ENDPOINT=http://tgi-node:8080
HF_TEI_ENDPOINT=http://localhost:8082
VLLM_ENDPOINT=http://vllm-node:8000

# ------------------------------------------------------------------------------
# 9. Cloud-Burst Providers & Commercial API Keys
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
COPILOT_API_KEY=
HF_TOKEN=
AWS_REGION=us-west-2
ARM_LOCATION=eastus

# ------------------------------------------------------------------------------
# 10. Zero-Cost / Self-Hosted Models & Token Governance Exemption
# ------------------------------------------------------------------------------
DENDRITE_ZERO_COST_MODELS=local-qwen-coder,local-qwen3-27b,local-qwen3-9b,oxillama-rust,vllm-cluster,hf-tgi-remote,llamacpp-local
DENDRITE_ZERO_COST_PREFIXES=ollama/,oxillama/,vllm/,llamacpp/,huggingface-tei/
